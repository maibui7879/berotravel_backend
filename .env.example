# ============================================================
# BeroTravel Backend - Complete Configuration Guide
# ============================================================

# ============ DATABASE ============
MONGO_URI=mongodb://localhost:27017/berotravel
DB_NAME=berotravel

# ============ JWT & AUTHENTICATION ============
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============ EMAIL SERVICE (Nodemailer) ============
# Gmail: https://myaccount.google.com/apppasswords
# SendGrid: https://app.sendgrid.com/settings/api_keys
MAIL_SERVICE=gmail
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_EMAIL=noreply@berotravel.com
MAIL_FROM_NAME=BeroTravel

# ============ PAYMENT GATEWAYS ============

# Stripe (US, International)
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# VNPay (Vietnam)
# Get credentials from: https://sandbox.vnpayment.vn/
VNPAY_MERCHANT_ID=your_merchant_id
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_API_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_DR_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# MoMo (Vietnam)
MOMO_PARTNER_CODE=MOMOXXXXXX
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_URL=https://test-payment.momo.vn/v2/gateway/api/query

# ZaloPay (Vietnam)
ZALOPAY_APP_ID=your_app_id
ZALOPAY_KEY1=your_key1
ZALOPAY_API_URL=https://sandbox.zalopay.com.vn/v001/tpe/createorder

# ============ URLS ============
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
PAYMENT_RETURN_URL=http://localhost:3000/payment-success
PAYMENT_WEBHOOK_URL=http://localhost:3001/payments/webhook

# ============ REDIS (Caching) ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ GOOGLE MAPS & LOCATION ============
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_DIRECTIONS_API_URL=https://maps.googleapis.com/maps/api/directions/json

# ============ AWS S3 (File Upload) ============
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=berotravel-images

# ============ LOGGING & ERROR TRACKING ============
# Winston Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14

# Sentry Error Tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Slack Notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============ ADMIN & SECURITY ============
# Super admin OTP secret (keep secure!)
ADMIN_OTP_SECRET=your_admin_secret

# Commission rate for merchants (15% = 0.15)
MERCHANT_COMMISSION_RATE=0.15

# ============ SOCIAL AUTH ============
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ============ ENVIRONMENT ============
NODE_ENV=development
PORT=3001

# ============ RATE LIMITING ============
# Requests per minute
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# ============ CORS ============
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://berotravel.com
